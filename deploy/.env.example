# CIAA backend — production environment.
# Copy to /opt/ciaa/.env on the VM, fill in real values, then: chmod 600 /opt/ciaa/.env
# (Owned by the 'ciaa' service user. NEVER commit the real file.)

# ── LLM provider (the analysis engine) ──────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# OPENAI_API_KEY=
# LLM_BASE_URL=                 # for Azure/Ollama/custom endpoints
LLM_TEMPERATURE=0.0            # 0 = deterministic (reproducible findings/gate)
LLM_REQUEST_TIMEOUT_S=45

# ── API authentication ──────────────────────────────────────────────────────
# Point at a keys file kept OUTSIDE the code tree (chmod 600). Do NOT set SKIP_AUTH in prod.
API_KEYS_FILE=/opt/ciaa/keys.json
# SKIP_AUTH=false

# ── CORS — set to your deployed frontend origin(s), comma-separated ─────────
CORS_ORIGINS=https://app.yourdomain.com

# ── Storage paths (writable dir owned by the service user) ──────────────────
SQLITE_PATH=/opt/ciaa/data/reports.db
FEEDBACK_DB_PATH=/opt/ciaa/data/feedback.db
AUDIT_LOG_PATH=/opt/ciaa/data/audit.log

# ── Reliability / concurrency ───────────────────────────────────────────────
ANALYSIS_TIMEOUT_S=600
MAX_CONCURRENT_ANALYSES=8
MAX_QUEUED_ANALYSES=50
USE_LANGGRAPH=false           # keep false → fast parallel pipeline

# ── Gunicorn (read by gunicorn_conf.py) ─────────────────────────────────────
BIND=127.0.0.1:8080
WEB_WORKERS=1                 # keep 1 until Redis-backed shared state is added
LOG_LEVEL=info

# ── Optional integrations ───────────────────────────────────────────────────
# GITHUB_TOKEN=
# BITBUCKET_TOKEN=
# DIGEST_ENABLED=false

# ──────────────────────────────────────────────────────────────────────
#  AI Impact Analysis Framework — Environment Configuration
#  Copy to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────

# ── Anthropic ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── LLM request reliability (self-hosted / slow models) ────────────────
# Stream OpenAI-compatible completions so the timeout below is a PER-CHUNK read
# timeout, not a cap on the whole generation. This is the main fix for
# APITimeoutError on heavy agents (QA scenarios, interface/reference impact)
# against a slow on-prem GPU. Set false only if your server rejects streaming.
LLM_STREAM=true
LLM_REQUEST_TIMEOUT_S=120     # per-chunk read timeout when streaming; whole-call when not
LLM_RETRY_ATTEMPTS=5
LLM_TIMEOUT_RETRY_ATTEMPTS=1   # timeouts fail fast (don't hammer a slow/overloaded model)
LLM_RETRY_MAX_WAIT_S=90
ANALYSIS_TIMEOUT_S=900        # overall hard cap for one analysis (raise for slow models)
LLM_MAX_CONCURRENCY=8         # lower (2-4) for a small self-hosted endpoint

# ── Analysis Phase ─────────────────────────────────────────────────────
# 1 = Code Analysis + Security only
# 2 = Phase 1 + Dependency + Test Coverage + Interface + Risk  (default)
# 3 = Phase 2 + Remediation + Executive Summary
ANALYSIS_PHASE=2

# ── Token Budgets (per agent per run, input+output combined) ────────────
BUDGET_CODE_ANALYSIS=4000
BUDGET_SECURITY=5000
BUDGET_DEPENDENCY=2000
BUDGET_TEST_COVERAGE=3000
BUDGET_INTERFACE=4000
BUDGET_RISK=3000
BUDGET_REMEDIATION=4000
BUDGET_RESERVE=3000

# ── Git Provider ───────────────────────────────────────────────────────
GIT_PROVIDER=github           # bitbucket | github

# Bitbucket (when GIT_PROVIDER=bitbucket)
BITBUCKET_API_URL=https://api.bitbucket.org/2.0
BITBUCKET_TOKEN=
BITBUCKET_WORKSPACE=myworkspace
BITBUCKET_WEBHOOK_SECRET=

# GitHub (when GIT_PROVIDER=github)
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=

# ── Storage backends ───────────────────────────────────────────────────
# DATA_DIR — ONE base directory for everything the app writes (reports, users,
# feedback, review sessions, temporal history, audit log). Point it at an
# ABSOLUTE path OUTSIDE the deployed code so re-deploying never overwrites state.
# Leave as 'data' for local dev. Per-file overrides (SQLITE_PATH, AUDIT_LOG_PATH,
# FEEDBACK_DB_PATH, USER_DB_PATH, REVIEW_SESSION_DB_PATH, TEMPORAL_DB_PATH) win
# when set — leave them BLANK so they default under DATA_DIR.
DATA_DIR=data

# ── SCA / vulnerability lookups ────────────────────────────────────────
# Source: osv (public DB) or xray (JFrog Xray on Artifactory — in-house).
VULN_SOURCE=osv
# Fallback when the primary source is down (after retries):
#   none    = fail with a clear error (default)
#   osv     = public OSV (sends dependency names outside the bank)
#   xray    = JFrog Xray (in-house)
#   offline = OSV local copy (snapshot zips in OSV_OFFLINE_DIR)
VULN_FALLBACK_SOURCE=none
# OSV access on a restricted network (all optional):
OSV_BASE_URL=                       # internal OSV mirror/passthrough; blank = https://api.osv.dev
OSV_PROXY_URL=                      # corporate forward proxy for OSV ONLY, e.g. http://proxy.bank.com:8080
OSV_CA_BUNDLE=                      # corporate root CA (TLS-intercepting proxy) — keeps verification ON
OSV_VERIFY_SSL=true                 # false = INSECURE, last resort
# Last-resort OFFLINE snapshot dir when every live source is down (air-gapped).
# Download on an internet machine, copy in, refresh periodically:
#   curl -L -o Maven.zip https://osv-vulnerabilities.storage.googleapis.com/Maven/all.zip
#   curl -L -o NuGet.zip https://osv-vulnerabilities.storage.googleapis.com/NuGet/all.zip
OSV_OFFLINE_DIR=                    # e.g. /prodlib/CLSSGPOC/CRIAFSG/var/osv-snapshots
# JFrog Xray (when VULN_SOURCE=xray or selected in the UI):
XRAY_BASE_URL=                      # e.g. https://artifactory.company.com/xray
XRAY_AUTH=                          # Bearer <token> (or raw token)
# Maven repo for parent-POM/BOM + transitive resolution:
MAVEN_REPO_URL=                     # internal Artifactory; blank = Maven Central
MAVEN_REPO_AUTH=                    # Authorization header value (Bearer/Basic …)
# Example (production): DATA_DIR=/prodlib/CLSSGPOC/CRIAFSG/var

# ChromaDB (vector store — leave blank to use in-memory keyword fallback)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Redis (report persistence — leave blank to use in-memory store)
REDIS_URL=redis://localhost:6379/0

# Neo4j (service dependency graph — leave blank to use NetworkX in-process)
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── API Authentication ─────────────────────────────────────────────────
# Rich keys (roles, names, user_id) live in a JSON file — this is the primary
# way to manage keys. Defaults to config/keys.json; point it at an ABSOLUTE path
# outside the code for production so a re-deploy doesn't overwrite your keys.
API_KEYS_FILE=config/keys.json
# Optional extra plain keys (default role: developer). Leave empty if using the file.
API_KEYS=[]
SKIP_AUTH=false             # Set to true for development only (bypasses all auth)

# ── Output Integrations ────────────────────────────────────────────────
POST_PR_COMMENTS=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
TEAMS_WEBHOOK_URL=https://mycompany.webhook.office.com/webhookb2/...

# ── Email daily digest (SMTP) ──────────────────────────────────────────
# Daily summary of review queue + API spend, emailed to your team.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=ciaa@yourcompany.com
DIGEST_RECIPIENTS=lead@yourcompany.com,team@yourcompany.com
DIGEST_ENABLED=false        # set true to enable the daily scheduler
DIGEST_SEND_HOUR=8          # 0-23 UTC

# ── Governance ─────────────────────────────────────────────────────────
# Leave BLANK to keep the audit trail under DATA_DIR (recommended, persistent).
AUDIT_LOG_PATH=
COMPLIANCE_FRAMEWORKS=["MAS TRM","PCI-DSS 4.0","OWASP ASVS L2"]

# ── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# ── Phase 4: Jira Integration ──────────────────────────────────────────────────
JIRA_URL=https://yourorg.atlassian.net
JIRA_EMAIL=your-email@bank.com
JIRA_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=IMP

# ── Phase 4: ServiceNow Integration ───────────────────────────────────────────
SERVICENOW_INSTANCE=yourbank
SERVICENOW_USER=svc_impact_analyzer
SERVICENOW_PASSWORD=

# ── Phase 4: OpenTelemetry ─────────────────────────────────────────────────────
OTLP_ENDPOINT=http://jaeger:4317   # leave blank for console/disabled

# ── Phase 4: Circuit Breaker ──────────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_S=60
